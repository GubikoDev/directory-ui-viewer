{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Directory UI Viewer",
  "version": "0.1.0",
  "identifier": "io.github.bigwin22.directory-ui-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Directory UI Viewer",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["dmg", "appimage"]
  }
}
